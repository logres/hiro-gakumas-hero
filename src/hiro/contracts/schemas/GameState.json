    "description": "Source(origin: str, seq: int)"
   }
  },
  "seq": {
   "type": "integer"
  },
  "pending_page": {
   "title": "PageState",
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "area": {
     "type": "string"
    },
    "since_seq": {
     "type": "integer"
    },
    "stable": {
     "type": "boolean"
    },
    "frames": {
     "type": "integer"
    }
   },
