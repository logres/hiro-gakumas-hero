   }
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "mode",
  "page",
  "produce",
  "exam",
  "exam_session",
  "page_fields",
  "sources",
  "seq",
  "pending_page",
  "conflicts",
  "field_status",
  "pending_review",
  "ledger",
  "version"
 ],
